/* Echoes in the Dark — HUD. Amber = light, teal = safe/radio, red = danger. */

.root {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-definition: resource("Fonts/Rajdhani-SemiBold");
    color: rgb(230, 232, 236);
    font-size: 22px;
}

.layer, .look-area, .damage, .screen, .radio {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
}

.damage {
    background-color: rgba(120, 0, 8, 0.35);
    border-width: 0;
    opacity: 0;
}

/* ---------- status panel ---------- */

.panel {
    background-color: rgba(8, 10, 14, 0.55);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 14px 18px;
}

.status { position: absolute; left: 32px; top: 28px; width: 420px; }
.row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.k { width: 62px; font-size: 18px; letter-spacing: 3px; color: rgba(230, 232, 236, 0.55); }
.v { width: 78px; font-size: 19px; -unity-text-align: middle-right; letter-spacing: 1px; }
.v.danger { color: rgb(255, 98, 92); }

.bar {
    flex-grow: 1; height: 8px;
    background-color: rgba(40, 44, 52, 0.9);
    border-radius: 4px; overflow: hidden;
}
.bar-fill { height: 100%; width: 0; border-radius: 4px; transition-property: width; transition-duration: 0.12s; }
.bar-fill.light { background-color: rgb(232, 163, 60); }
.bar-fill.light.flicker { background-color: rgb(255, 92, 70); }
.bar-fill.light.charging { background-color: rgb(255, 214, 120); }
.bar-fill.mic { background-color: rgb(95, 211, 192); transition-duration: 0.05s; }
.bar-fill.dark { background-color: rgb(196, 40, 52); }
.tick { position: absolute; top: 0; bottom: 0; width: 2px; background-color: rgba(255, 255, 255, 0.45); }
.tick.shout { background-color: rgb(232, 163, 60); }

.chips { flex-direction: row; margin-top: 4px; }
.chip {
    font-size: 15px; letter-spacing: 2px;
    padding: 2px 10px; margin-right: 6px;
    border-radius: 10px;
    background-color: rgba(30, 33, 40, 0.8);
    color: rgba(230, 232, 236, 0.35);
}
.chip.on { background-color: rgba(95, 211, 192, 0.22); color: rgb(95, 211, 192); }
.chip.danger { background-color: rgba(220, 60, 60, 0.28); color: rgb(255, 120, 110); }

/* ---------- top centre ---------- */

.top-center { position: absolute; top: 26px; left: 0; right: 0; align-items: center; }
.timer { font-size: 34px; letter-spacing: 4px; -unity-font-definition: resource("Fonts/ShareTechMono-Regular"); }
.objective { font-size: 18px; letter-spacing: 3px; color: rgba(232, 163, 60, 0.85); }

/* ---------- compass (Member 5) ---------- */

.compass-host { position: absolute; right: 36px; top: 26px; align-items: center; }
.compass {
    border-radius: 88px;
    background-color: rgba(8, 10, 14, 0.55);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.10);
}
.compass-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; transform-origin: center; }
.compass-letter { position: absolute; width: 24px; height: 28px; -unity-text-align: middle-center; font-size: 20px; color: rgba(230, 232, 236, 0.8); }
.compass-letter.north { color: rgb(232, 163, 60); -unity-font-definition: resource("Fonts/Rajdhani-Bold"); }
.compass-lubber { position: absolute; left: 86px; top: -4px; width: 4px; height: 16px; border-radius: 2px; background-color: rgb(232, 163, 60); }
.compass-center { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.compass-cardinal { font-size: 30px; -unity-font-definition: resource("Fonts/Rajdhani-Bold"); }
.compass-heading { font-size: 16px; margin-top: -8px; color: rgba(230, 232, 236, 0.6); -unity-font-definition: resource("Fonts/ShareTechMono-Regular"); }
.compass-status { position: absolute; bottom: -26px; left: -20px; right: -20px; -unity-text-align: middle-center; font-size: 14px; letter-spacing: 3px; color: rgba(230, 232, 236, 0.45); }
.compass-status.danger { color: rgb(255, 98, 92); }
.compass-mark { position: absolute; width: 10px; height: 10px; border-radius: 5px; }
.compass-mark.meet { background-color: rgb(232, 163, 60); }
.compass-mark.partner { background-color: rgb(95, 211, 192); }
.corner-buttons { flex-direction: row; margin-top: 40px; }

/* ---------- prompts ---------- */

.prompt {
    position: absolute; left: 0; right: 0; top: 62%;
    -unity-text-align: middle-center;
    font-size: 30px; letter-spacing: 6px;
    color: rgba(232, 163, 60, 0.95);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
}
.prompt.danger { color: rgb(255, 92, 82); }
.prompt.pulse { scale: 1.06 1.06; }
.hint {
    position: absolute; left: 0; right: 0; bottom: 22px;
    -unity-text-align: middle-center; font-size: 16px; letter-spacing: 2px;
    color: rgba(230, 232, 236, 0.35);
}

/* ---------- touch controls ---------- */

.look-area { background-color: rgba(0, 0, 0, 0); }
.joy-area { position: absolute; left: 0; bottom: 0; width: 42%; height: 60%; }
.joy-base {
    position: absolute; left: 90px; top: 50%; width: 140px; height: 140px;
    border-radius: 70px; border-width: 2px; border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.03);
    align-items: center; justify-content: center;
}
.joy-base.active { border-color: rgba(232, 163, 60, 0.5); }
.joy-knob { width: 60px; height: 60px; border-radius: 30px; background-color: rgba(255, 255, 255, 0.18); }
.actions { position: absolute; right: 40px; bottom: 40px; flex-direction: row; flex-wrap: wrap; width: 360px; justify-content: flex-end; }
.hold-btn {
    width: 160px; height: 84px; margin: 8px;
    border-radius: 18px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(8, 10, 14, 0.55);
    -unity-text-align: middle-center; font-size: 22px; letter-spacing: 4px;
}
.hold-btn.held { background-color: rgba(232, 163, 60, 0.35); border-color: rgb(232, 163, 60); }

/* ---------- screens ---------- */

.screen {
    background-color: rgba(3, 4, 6, 0.80);
    align-items: center; justify-content: center;
    display: none;
}
.screen.menu { background-color: rgba(3, 4, 6, 0.55); }
.title {
    font-size: 96px; letter-spacing: 14px; color: rgb(244, 244, 246);
    -unity-font-definition: resource("Fonts/Rajdhani-Bold");
}
.title.danger { color: rgb(255, 82, 72); }
.tagline { font-size: 24px; letter-spacing: 4px; color: rgba(232, 163, 60, 0.9); margin-bottom: 40px; }
.menu-buttons { align-items: center; }
.foot { font-size: 16px; letter-spacing: 3px; color: rgba(230, 232, 236, 0.5); margin-top: 26px; }
.foot.dim { margin-top: 6px; color: rgba(230, 232, 236, 0.3); }

.unity-button.btn {
    width: 380px; height: 62px; margin: 7px;
    font-size: 24px; letter-spacing: 5px;
    color: rgb(237, 237, 240);
    background-color: rgba(14, 16, 21, 0.75);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    -unity-font-definition: resource("Fonts/Rajdhani-SemiBold");
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}
.unity-button.btn:hover { background-color: rgba(70, 46, 14, 0.9); border-color: rgba(232, 163, 60, 0.6); scale: 1.02 1.02; }
.unity-button.btn:active { background-color: rgba(110, 72, 20, 0.95); }
.unity-button.btn.primary { border-color: rgba(232, 163, 60, 0.8); background-color: rgba(60, 38, 12, 0.85); }
.unity-button.btn.small { width: auto; height: 42px; font-size: 17px; padding: 0 18px; letter-spacing: 3px; }

.card {
    width: 620px; padding: 34px 40px; align-items: center;
    background-color: rgba(12, 14, 19, 0.92);
    border-radius: 20px; border-width: 1px; border-color: rgba(255, 255, 255, 0.08);
}
.card.wide { width: 860px; align-items: stretch; }
.card-kicker { font-size: 15px; letter-spacing: 5px; color: rgba(95, 211, 192, 0.9); margin-top: 8px; margin-bottom: 6px; }
.card-title { font-size: 44px; letter-spacing: 8px; -unity-font-definition: resource("Fonts/Rajdhani-Bold"); margin-bottom: 8px; -unity-text-align: middle-center; }
.card-sub { font-size: 20px; color: rgba(230, 232, 236, 0.7); white-space: normal; -unity-text-align: middle-center; margin-bottom: 18px; }
.card-sub.dim { font-size: 17px; color: rgba(230, 232, 236, 0.4); }
.card .bar { width: 100%; flex-grow: 0; height: 10px; margin: 6px 0 18px 0; }
.field { width: 100%; height: 56px; font-size: 26px; margin-bottom: 14px; }
.setting { margin: 6px 0; font-size: 20px; }
.setting Label { min-width: 300px; color: rgba(230, 232, 236, 0.8); }
.sensors {
    -unity-font-definition: resource("Fonts/ShareTechMono-Regular");
    font-size: 17px; color: rgba(230, 232, 236, 0.75);
    background-color: rgba(20, 22, 28, 0.9); border-radius: 10px; padding: 12px 16px; margin-bottom: 14px;
}

/* ---------- radio overlay (Member 6) ---------- */

.radio {
    background-color: rgb(2, 3, 4);
    align-items: center; justify-content: center;
    -unity-font-definition: resource("Fonts/ShareTechMono-Regular");
    color: rgb(95, 211, 192);
}
.radio-title { font-size: 30px; letter-spacing: 6px; margin-bottom: 26px; }
.radio-wave { flex-direction: row; align-items: center; height: 90px; margin-bottom: 30px; }
.radio-bar { width: 8px; margin: 0 3px; height: 10px; border-radius: 3px; background-color: rgba(95, 211, 192, 0.7); }
.radio-line { font-size: 24px; letter-spacing: 2px; width: 760px; margin: 5px 0; color: rgba(95, 211, 192, 0.85); }
.radio-line.danger { color: rgb(255, 98, 92); }
.radio-foot { margin-top: 30px; font-size: 16px; letter-spacing: 3px; color: rgba(95, 211, 192, 0.45); }

/* ---------- how to play ---------- */

.tips { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin: 10px 0 14px 0; }
.tip {
    width: 49%; margin-bottom: 10px; padding: 12px 16px;
    background-color: rgba(20, 22, 28, 0.9); border-radius: 12px;
    border-left-width: 3px; border-color: rgb(232, 163, 60);
}
.tip-head { font-size: 19px; letter-spacing: 3px; color: rgb(232, 163, 60); -unity-font-definition: resource("Fonts/Rajdhani-Bold"); }
.tip-body { font-size: 18px; color: rgba(230, 232, 236, 0.75); white-space: normal; }

/* ---------- tilt hatch lock ---------- */

.tilt {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(3, 4, 6, 0.72);
    align-items: center; justify-content: center;
}
.tilt-box {
    background-color: rgba(18, 16, 12, 0.95);
    border-width: 3px; border-color: rgb(120, 86, 40); border-radius: 18px;
    overflow: hidden;
}
.tilt-wall { position: absolute; background-color: rgb(120, 86, 40); border-radius: 4px; }
.tilt-hole { position: absolute; border-radius: 20px; background-color: rgb(0, 0, 0); border-width: 3px; border-color: rgb(95, 211, 192); }
.tilt-ball { position: absolute; border-radius: 15px; background-color: rgb(232, 163, 60); }
.card.wide > .unity-button.btn { align-self: center; }

/* ---------- new gameplay: flash, struggle, fuses, chips ---------- */
.flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(255, 250, 235); opacity: 0; }
.chips { flex-wrap: wrap; }
.chip { margin-bottom: 4px; }
.chip.ready { background-color: rgba(70, 46, 14, 0.95); color: rgb(255, 196, 90); }
.struggle { position: absolute; left: 30%; right: 30%; top: 70%; height: 16px; display: none; }
.struggle .bar { height: 14px; flex-grow: 1; border-width: 1px; border-color: rgb(255, 92, 82); }
.compass-mark.fuse { background-color: rgb(80, 240, 215); }
